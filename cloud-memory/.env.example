PORT=8787
# Long random secret — whoever/whatever connects (Claude, ChatGPT, Grok, ...)
# must send it as "Authorization: Bearer <token>".
CLOUD_MEMORY_TOKEN=replace-with-a-long-random-secret

SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key, NOT the publishable/anon key — this server needs full
# read/write on the cloud_memory table. Keep it out of git.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
